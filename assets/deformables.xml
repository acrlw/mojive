<mujoco model="forge deformables">
  <compiler angle="degree"/>
  <option timestep="0.001" integrator="implicitfast" gravity="0 0 -9.81"/>

  <visual>
    <headlight diffuse="0.65 0.65 0.65" ambient="0.22 0.22 0.22" specular="0.25 0.25 0.25"/>
    <global azimuth="132" elevation="-22"/>
  </visual>

  <asset>
    <texture name="grid" type="2d" builtin="checker" width="256" height="256"
             rgb1="0.11 0.17 0.22" rgb2="0.18 0.27 0.34"/>
    <texture name="cloth_grid" type="2d" builtin="checker" width="256" height="256"
             rgb1="0.28 0.62 0.92" rgb2="0.48 0.78 1.0"/>
    <material name="floor_mat" texture="grid" texrepeat="2 2" texuniform="true"
              specular="0.2" shininess="0.25" reflectance="0.12"/>
    <material name="cloth_mat" texture="cloth_grid" texrepeat="6 6" rgba="1 1 1 1"
              specular="0.3" shininess="0.35"/>
    <material name="cable_mat" rgba="0.95 0.42 0.16 1" specular="0.25" shininess="0.3"/>
    <material name="volume_mat" rgba="0.34 0.82 0.49 0.82" specular="0.2" shininess="0.25"/>
    <material name="skin_mat" rgba="0.82 0.40 0.92 1" specular="0.35" shininess="0.45"/>
  </asset>

  <worldbody>
    <geom name="floor" type="plane" size="0 0 0.05" material="floor_mat"/>
    <light name="key" directional="true" pos="1 -2 4" dir="-0.2 0.35 -1"
           diffuse="0.55 0.55 0.55" specular="0.25 0.25 0.25"/>

    <flexcomp name="cloth" type="grid" dim="2" count="7 7 1" spacing="0.12 0.12 0.12"
              pos="-1.15 -0.25 1.05" quat="0.70710678 -0.70710678 0 0"
              radius="0.008" mass="0.08" material="cloth_mat">
      <contact selfcollide="none"/>
      <edge equality="true" solref="0.02 1"/>
      <pin grid="0 0"/>
      <pin grid="6 0"/>
    </flexcomp>

    <flexcomp name="cable" type="grid" dim="1" count="9 1 1" spacing="0.1 0.1 0.1"
              pos="-1.15 0.55 1.15" radius="0.018" mass="0.16" material="cable_mat">
      <contact selfcollide="none"/>
      <edge stiffness="120" damping="0.2"/>
      <pin id="0"/>
    </flexcomp>

    <flexcomp name="soft_volume" type="grid" dim="3" count="3 3 3" spacing="0.13 0.13 0.13"
              pos="-0.15 0.35 0.75" radius="0.006" mass="0.4" material="volume_mat">
      <contact selfcollide="none"/>
      <elasticity young="100" poisson="0.3" damping="0.2"/>
      <pin id="0 1 2"/>
    </flexcomp>

    <body name="skin_root" pos="0.55 0 0.85">
      <joint name="skin_root_hinge" type="hinge" axis="0 1 0" range="-35 35" damping="1"/>
      <geom type="box" size="0.035 0.035 0.035" group="3" mass="0.2"/>
      <body name="skin_tip" pos="0.4 0 0">
        <joint name="skin_tip_hinge" type="hinge" axis="0 1 0" range="-70 70" damping="1"/>
        <geom type="box" size="0.035 0.035 0.035" group="3" mass="0.2"/>
      </body>
    </body>
  </worldbody>

  <deformable>
    <skin name="ribbon" material="skin_mat"
          vertex="0.35 -0.15 0.85  0.35 0.15 0.85
                  0.75 -0.15 0.85  0.75 0.15 0.85
                  1.15 -0.15 0.85  1.15 0.15 0.85"
          texcoord="0 0  0 1  0.5 0  0.5 1  1 0  1 1"
          face="0 2 1  1 2 3  2 4 3  3 4 5" inflate="0.004">
      <bone body="skin_root" bindpos="0.55 0 0.85" bindquat="1 0 0 0"
            vertid="0 1 2 3" vertweight="1 1 0.5 0.5"/>
      <bone body="skin_tip" bindpos="0.95 0 0.85" bindquat="1 0 0 0"
            vertid="2 3 4 5" vertweight="0.5 0.5 1 1"/>
    </skin>
  </deformable>

  <keyframe>
    <key name="bent" qpos="-15 45"/>
  </keyframe>
</mujoco>
