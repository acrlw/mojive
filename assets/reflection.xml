
<mujoco model="reflection">
  <compiler angle="degree" autolimits="true"/>

  <visual>
    <headlight ambient="0.18 0.18 0.20" diffuse="0.35 0.35 0.35" specular="0.3 0.3 0.3"/>
    <quality shadowsize="4096" numslices="28" numstacks="16"/>
    <map znear="0.02" zfar="60" shadowclip="1.5" shadowscale="0.7"/>
  </visual>

  <asset>
    <texture name="grid" type="2d" builtin="checker" width="512" height="512"
             rgb1="0.14 0.16 0.19" rgb2="0.26 0.29 0.34"/>

    <material name="mirror" texture="grid" texrepeat="1 1" texuniform="true"
              reflectance="0.35"/>

    <material name="hot"  rgba="0.95 0.25 0.15 1" specular="0.2" shininess="0.3"/>
    <material name="cool" rgba="0.20 0.45 0.95 1" specular="0.2" shininess="0.3"/>
    <material name="pale" rgba="0.85 0.85 0.88 1" specular="0.4" shininess="0.5"/>
    <material name="deep" rgba="0.15 0.75 0.35 1" specular="0.2" shininess="0.3"/>
  </asset>

  <worldbody>
    <light name="sun" type="directional" pos="2.0 -3.0 5" dir="-0.3 0.45 -1"
           diffuse="0.70 0.70 0.68" specular="0.25 0.25 0.25" castshadow="true"/>

    <geom name="floor" type="plane" size="0 0 0.05" material="mirror"/>

    <geom name="high" type="sphere" size="0.28" pos="-0.8 0.0 1.30" material="hot"/>
    <geom name="low"  type="sphere" size="0.28" pos="0.8 0.0 0.35" material="cool"/>

    <geom name="buried" type="sphere" size="0.45" pos="0.0 1.6 -0.60" material="deep"/>

    <geom name="shell_a" type="box" size="0.45 0.03 0.35" pos="0.0 -1.15 0.35" material="pale"/>
    <geom name="shell_b" type="box" size="0.45 0.03 0.35" pos="0.0 -2.05 0.35" material="pale"/>
    <geom name="shell_c" type="box" size="0.03 0.45 0.35" pos="-0.45 -1.60 0.35" material="pale"/>
    <geom name="shell_d" type="box" size="0.03 0.45 0.35" pos="0.45 -1.60 0.35" material="pale"/>
  </worldbody>
</mujoco>
