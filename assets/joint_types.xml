
<mujoco model="joint_types">
  <compiler angle="degree" autolimits="true"/>
  <option gravity="0 0 0"/>

  <visual>
    <headlight ambient="0.28 0.28 0.28" diffuse="0.45 0.45 0.45" specular="0.4 0.4 0.4"/>
    <quality shadowsize="2048" numslices="28" numstacks="16"/>
    <map znear="0.02" zfar="40"/>
  </visual>

  <asset>
    <texture name="grid" type="2d" builtin="checker" width="512" height="512"
             rgb1="0.19 0.21 0.25" rgb2="0.29 0.32 0.37"/>
    <material name="grid" texture="grid" texrepeat="1 1" texuniform="true"/>
    <material name="free" rgba="0.90 0.45 0.20 1" specular="0.5" shininess="0.6"/>
    <material name="ball" rgba="0.35 0.70 0.85 1" specular="0.5" shininess="0.6"/>
    <material name="slide" rgba="0.45 0.80 0.45 1" specular="0.5" shininess="0.6"/>
    <material name="hinge" rgba="0.80 0.75 0.30 1" specular="0.5" shininess="0.6"/>
    <material name="chain" rgba="0.70 0.45 0.85 1" specular="0.5" shininess="0.6"/>
    <material name="fixed" rgba="0.55 0.55 0.58 1" specular="0.2" shininess="0.3"/>
    <material name="anchor" rgba="0.35 0.35 0.38 1" specular="0.2" shininess="0.3"/>
  </asset>

  <worldbody>
    <light name="sun" type="directional" pos="2 -3 5" dir="-0.3 0.45 -1"
           diffuse="0.7 0.7 0.7" specular="0.3 0.3 0.3" castshadow="true"/>

    <geom name="floor" type="plane" size="0 0 0.05" material="grid"/>

    <body name="free_body" pos="-1.60 0 0.55">
      <freejoint name="free"/>
      <geom name="free_box" type="box" size="0.18 0.18 0.18" material="free"/>
      <geom name="free_nose" type="capsule" fromto="0 0 0.18 0 0 0.36" size="0.05"
            material="free"/>
    </body>

    <body name="ball_anchor" pos="-0.80 0 0.90">
      <geom name="ball_anchor" type="box" size="0.06 0.06 0.06" material="anchor"/>
      <body name="ball_body" pos="0 0 -0.28">
        <joint name="ball" type="ball"/>
        <geom name="ball_link" type="capsule" fromto="0 0 0.28 0 0 -0.20" size="0.05"
              material="ball"/>
        <geom name="ball_tip" type="sphere" pos="0 0 -0.20" size="0.09" material="ball"/>
      </body>
    </body>

    <body name="slide_rail" pos="0 0 0.55">
      <geom name="slide_rail" type="capsule" fromto="0 -0.45 0 0 0.45 0" size="0.02"
            material="anchor"/>
      <body name="slide_body">
        <joint name="slide" type="slide" axis="0 1 0" range="-0.35 0.35"/>
        <geom name="slide_block" type="box" size="0.10 0.08 0.10" material="slide"/>
      </body>
    </body>

    <body name="hinge_anchor" pos="0.85 0 0.55">
      <geom name="hinge_anchor" type="cylinder" pos="0 0 0" size="0.05 0.10" euler="90 0 0"
            material="anchor"/>
      <body name="hinge_body">
        <joint name="hinge_limited" type="hinge" axis="0 1 0" range="-60 60"/>
        <geom name="hinge_arm" type="capsule" fromto="0 0 0 0.40 0 0" size="0.045"
              material="hinge"/>
      </body>
    </body>
    <body name="hinge_free_anchor" pos="0.85 0.70 0.55">
      <geom name="hinge_free_anchor" type="cylinder" size="0.05 0.10" euler="90 0 0"
            material="anchor"/>
      <body name="hinge_free_body">
        <joint name="hinge_unlimited" type="hinge" axis="0 1 0"/>
        <geom name="hinge_free_arm" type="capsule" fromto="0 0 0 0.40 0 0" size="0.045"
              material="hinge"/>
      </body>
    </body>

    <body name="chain_root" pos="1.90 -0.60 0.20">
      <geom name="chain_base" type="box" size="0.10 0.10 0.10" material="anchor"/>
      <body name="chain_0" pos="0 0 0.10">
        <joint name="chain_0" type="hinge" axis="0 1 0" range="-90 90"/>
        <geom name="chain_0" type="capsule" fromto="0 0 0 0 0 0.35" size="0.04" material="chain"/>
        <body name="chain_1" pos="0 0 0.35">
          <joint name="chain_1" type="hinge" axis="0 1 0" range="-120 120"/>
          <geom name="chain_1" type="capsule" fromto="0 0 0 0 0 0.30" size="0.035"
                material="chain"/>
          <body name="chain_2" pos="0 0 0.30">
            <joint name="chain_2" type="hinge" axis="1 0 0" range="-120 120"/>
            <geom name="chain_2" type="capsule" fromto="0 0 0 0 0 0.24" size="0.03"
                  material="chain"/>
          </body>
        </body>
      </body>
    </body>

    <body name="free_chain" pos="-1.60 1.10 0.60">
      <freejoint name="free_chain"/>
      <geom name="free_chain_base" type="box" size="0.12 0.12 0.08" material="free"/>
      <body name="free_chain_0" pos="0 0 0.08">
        <joint name="free_chain_0" type="hinge" axis="0 1 0" range="-90 90"/>
        <geom name="free_chain_0" type="capsule" fromto="0 0 0 0 0 0.28" size="0.035"
              material="chain"/>
        <body name="free_chain_1" pos="0 0 0.28">
          <joint name="free_chain_1" type="hinge" axis="1 0 0" range="-90 90"/>
          <geom name="free_chain_1" type="capsule" fromto="0 0 0 0 0 0.22" size="0.03"
                material="chain"/>
        </body>
      </body>
    </body>

    <body name="welded" pos="1.90 0.75 0.18">
      <geom name="welded" type="box" size="0.18 0.18 0.18" material="fixed"/>
    </body>

    <camera name="joints" pos="0.15 -3.20 1.75" xyaxes="1 0 0 0 0.42 0.91"/>
  </worldbody>

  <actuator>
    <position name="hinge_pos" joint="hinge_limited" kp="8" ctrlrange="-1.05 1.05"/>
    <position name="slide_pos" joint="slide" kp="20" ctrlrange="-0.35 0.35"/>
  </actuator>
</mujoco>
