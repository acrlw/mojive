<!--
  parity_scene —— 对拍关卡的固定场景（12 §12.5）。

  守的性质：**逐帧完全一样**。对拍是"同机位跑两条后端、逐项比对"，任何一处随时间变的
  东西都会把差异图变成噪声，三个指标（边缘 IoU、分块亮度差、贴图内容正确性）就全都
  失去意义。所以：**没有关节、没有自由体、没有执行器**，`mj_forward` 之后一切不动。

  内容按三个指标反过来挑：
  - **边缘 IoU**（几何位置对不对）：六种几何、互相遮挡、有细杆也有大面，边缘密度足够；
  - **分块亮度差**（明暗分布对不对）：一盏能投影的方向光 + 一面接影的地板 + 一堵墙，
    画面里同时有全亮、半影、全影三档；
  - **贴图内容正确性**：地板的棋盘格（相位目标）。四色格在 `parity_texture.xml`。

  **五个机位写死在文件里**（12 §12.5 的"固定的 5 个机位"）。写在场景里而不是脚本里，
  是因为机位是这份关卡的一部分：换一个机位，历史数字就不可比了。
-->
<mujoco model="parity_scene">
  <compiler angle="degree" autolimits="true"/>

  <visual>
    <headlight ambient="0.2 0.2 0.2" diffuse="0.4 0.4 0.4" specular="0.5 0.5 0.5"/>
    <quality shadowsize="4096" numslices="28" numstacks="16"/>
    <map znear="0.02" zfar="60" shadowclip="1.5" shadowscale="0.7"/>
  </visual>

  <asset>
    <texture name="grid" type="2d" builtin="checker" width="512" height="512"
             rgb1="0.16 0.18 0.22" rgb2="0.30 0.33 0.38"/>
    <material name="grid" texture="grid" texrepeat="1 1" texuniform="true" reflectance="0.1"/>

    <material name="wall" rgba="0.55 0.55 0.58 1" specular="0.15" shininess="0.2"/>
    <material name="matte" rgba="0.80 0.35 0.25 1" specular="0.05" shininess="0.1"/>
    <material name="glossy" rgba="0.25 0.45 0.80 1" specular="0.9" shininess="0.9"/>
    <material name="mid" rgba="0.35 0.70 0.35 1" specular="0.5" shininess="0.5"/>
    <material name="glow" rgba="0.85 0.75 0.25 1" emission="0.4" specular="0.3" shininess="0.4"/>
    <material name="thin" rgba="0.90 0.90 0.92 1" specular="0.7" shininess="0.8"/>
  </asset>

  <worldbody>
    <!-- 唯一的场景光。方向写死，因为影子的位置本身就是被对拍的量 -->
    <light name="sun" type="directional" pos="2.5 -3.5 5" dir="-0.4 0.55 -1"
           diffuse="0.75 0.75 0.72" specular="0.3 0.3 0.3" castshadow="true"/>

    <geom name="floor" type="plane" size="0 0 0.05" material="grid"/>

    <!-- 挡光墙：让画面里同时有全亮、半影、全影三档 -->
    <geom name="wall" type="box" pos="-0.9 0.9 0.6" size="0.05 0.9 0.6" material="wall"/>

    <!-- 六种几何，尺度从 0.5 m 到 0.06 m。互相遮挡是故意的：边缘 IoU 要的正是重叠边 -->
    <geom name="sphere_matte" type="sphere" pos="0.0 0.0 0.25" size="0.25" material="matte"/>
    <geom name="sphere_glossy" type="sphere" pos="0.55 0.30 0.18" size="0.18" material="glossy"/>
    <geom name="box_mid" type="box" pos="-0.55 -0.20 0.20" size="0.20 0.20 0.20" material="mid"/>
    <geom name="cyl_glow" type="cylinder" pos="0.30 -0.60 0.22" size="0.14 0.22" material="glow"/>
    <geom name="cap_thin" type="capsule" fromto="-0.30 0.55 0.05 0.45 0.75 0.70" size="0.05"
          material="thin"/>
    <geom name="ellip" type="ellipsoid" pos="-0.20 -0.75 0.12" size="0.30 0.12 0.12"
          material="glossy"/>
    <geom name="pin_a" type="capsule" fromto="0.85 -0.10 0 0.85 -0.10 0.45" size="0.012"
          material="thin"/>
    <geom name="pin_b" type="capsule" fromto="0.95 -0.05 0 0.95 -0.05 0.35" size="0.012"
          material="matte"/>
    <geom name="grain" type="sphere" pos="0.75 0.05 0.06" size="0.06" material="mid"/>

    <!-- 五个机位。远近、俯仰、正侧各占一档，覆盖不同的透视强度与遮挡关系 -->
    <camera name="p0_overview" pos="2.20 -2.40 1.70" xyaxes="0.74 0.68 0 -0.30 0.32 0.90"/>
    <camera name="p1_close" pos="0.95 -1.05 0.55" xyaxes="0.74 0.68 0 -0.13 0.14 0.98"/>
    <camera name="p2_low" pos="1.80 -0.20 0.16" xyaxes="0.11 0.99 0 -0.05 0.01 1.00"/>
    <camera name="p3_top" pos="0.10 -0.30 3.20" xyaxes="1 0 0 0 1 0"/>
    <camera name="p4_side" pos="-2.60 0.30 0.90" xyaxes="0 -1 0 0.32 0 0.95"/>
  </worldbody>
</mujoco>
