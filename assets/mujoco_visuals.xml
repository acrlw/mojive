<mujoco model="opengl MuJoCo visuals">
  <option timestep="0.002" gravity="0 0 -9.81"/>
  <visual>
    <global azimuth="135" elevation="-24" fovy="48"/>
    <headlight ambient="0.25 0.25 0.25" diffuse="0.65 0.65 0.65"/>
  </visual>
  <asset>
    <hfield name="terrain" nrow="5" ncol="5" size="2.4 2.4 .28 .12"
      elevation="0 .1 .2 .1 0  .1 .3 .5 .3 .1  .2 .5 1 .5 .2  .1 .3 .5 .3 .1  0 .1 .2 .1 0"/>
    <material name="ground" rgba="0.28 0.38 0.31 1" specular="0.18" shininess="0.25"/>
  </asset>
  <worldbody>
    <light name="sun" directional="true" pos="0 -2 5" dir="0 .3 -1" castshadow="true"/>
    <camera name="overview" pos="4 -4 3" zaxis="4 -4 2.2" fovy="42"/>
    <camera name="calibrated_shift" pos="4 -4 3" zaxis="4 -4 2.2"
            sensorsize=".036 .024" focal=".04 .04" principal=".003 -.002"
            resolution="1920 1080"/>
    <geom name="terrain" type="hfield" hfield="terrain" material="ground"/>
    <body name="pendulum" pos="0 0 1.4">
      <joint name="hinge" type="hinge" axis="0 1 0" damping="0.08"/>
      <geom name="arm" type="capsule" fromto="0 0 0 0 0 -.75" size=".07" rgba=".72 .68 .58 1"/>
      <geom name="collision_debug" group="3" type="capsule" fromto="0 0 .05 0 0 -.8"
        size=".11" contype="0" conaffinity="0" rgba="1 .2 .6 .28"/>
      <site name="pivot" type="sphere" size=".09" rgba=".95 .35 .24 1"/>
      <site name="tip" type="box" pos="0 0 -.75" size=".10 .07 .05" rgba=".25 .65 .95 1"/>
    </body>
    <body name="ball" pos=".85 0 1.25">
      <freejoint/>
      <geom type="sphere" size=".18" rgba=".92 .55 .18 1"/>
      <camera name="ball_camera" pos="0 -.65 .28" zaxis="0 -.65 .28" fovy="55"/>
      <site name="ball_site" type="sphere" size=".045" pos="0 0 .2" rgba="1 1 1 1"/>
    </body>
  </worldbody>
  <tendon>
    <spatial name="guide" width=".018" rgba=".25 .9 .8 1">
      <site site="pivot"/>
      <site site="tip"/>
    </spatial>
  </tendon>
  <actuator>
    <general name="guide_actuator" tendon="guide" gainprm="0" ctrlrange="0 1"/>
  </actuator>
</mujoco>
