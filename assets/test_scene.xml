
<mujoco model="test_scene">
  <compiler angle="degree" autolimits="true"/>

  <visual>
    <headlight ambient="0.25 0.25 0.25" diffuse="0.4 0.4 0.4" specular="0.5 0.5 0.5"/>
    <quality shadowsize="4096" numslices="28" numstacks="16"/>
    <map znear="0.02" zfar="60" shadowclip="1.2" shadowscale="0.7"/>
  </visual>

  <asset>
    <texture name="grid" type="2d" builtin="checker" width="512" height="512"
             rgb1="0.19 0.21 0.25" rgb2="0.28 0.31 0.36"/>
    <material name="grid" texture="grid" texrepeat="1 1" texuniform="true" reflectance="0.15"/>

    <material name="axis_x" rgba="0.85 0.20 0.20 1" specular="0.4" shininess="0.4"/>
    <material name="axis_y" rgba="0.20 0.75 0.25 1" specular="0.4" shininess="0.4"/>
    <material name="axis_z" rgba="0.25 0.40 0.90 1" specular="0.4" shininess="0.4"/>

    <material name="mark_a" rgba="0.90 0.65 0.20 1" specular="0.5" shininess="0.6"/>
    <material name="mark_b" rgba="0.35 0.70 0.80 1" specular="0.5" shininess="0.6"/>
    <material name="mark_c" rgba="0.75 0.75 0.78 1" specular="0.8" shininess="0.9"/>
    <material name="mark_d" rgba="0.65 0.35 0.75 1" specular="0.3" shininess="0.3"/>
  </asset>

  <worldbody>
    <light name="sun" type="directional" pos="3 -4 6" dir="-0.35 0.45 -1"
           diffuse="0.7 0.7 0.7" specular="0.25 0.25 0.25" castshadow="true"/>

    <geom name="floor" type="plane" size="0 0 0.05" material="grid"/>

    <body name="frame">
      <geom name="axis_x" type="capsule" fromto="0 0 0.02 0.5 0 0.02" size="0.015"
            material="axis_x"/>
      <geom name="axis_y" type="capsule" fromto="0 0 0.02 0 0.5 0.02" size="0.015"
            material="axis_y"/>
      <geom name="axis_z" type="capsule" fromto="0 0 0.02 0 0 0.52" size="0.015"
            material="axis_z"/>
      <geom name="axis_origin" type="sphere" pos="0 0 0.02" size="0.03" material="mark_c"/>
    </body>

    <body name="mark_sphere" pos="1 0 0.15">
      <geom name="mark_sphere" type="sphere" size="0.15" material="mark_a"/>
    </body>
    <body name="mark_box" pos="0 1 0.15">
      <geom name="mark_box" type="box" size="0.15 0.15 0.15" material="mark_b"/>
    </body>
    <body name="mark_cylinder" pos="-1 0 0.2">
      <geom name="mark_cylinder" type="cylinder" size="0.12 0.2" material="mark_c"/>
    </body>
    <body name="mark_capsule" pos="0 -1 0">
      <geom name="mark_capsule" type="capsule" fromto="-0.15 0 0.1 0.15 0 0.35" size="0.09"
            material="mark_d"/>
    </body>

    <camera name="default" pos="2.4 -2.6 1.9" xyaxes="0.73 0.68 0 -0.30 0.32 0.90"/>
  </worldbody>
</mujoco>
