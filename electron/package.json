{
  "name": "mojive-electron",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "main/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "npm run build && electron .",
    "desktop": "electron .",
    "build": "tsc --noEmit && npm run compile-menu-icons && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "acceptance": "node scripts/workspace-acceptance.mjs",
    "postinstall": "node scripts/install-runtime.cjs",
    "sync-design": "node scripts/sync-design.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "format": "prettier --write src main scripts tests docs README.md",
    "compile-menu-icons": "electron scripts/compile-menu-icons.cjs",
    "bundle-smoke": "node scripts/bundle-smoke.mjs"
  },
  "dependencies": {
    "i18next": "^26.7.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.1.12",
    "three": "^0.181.0"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.181.0",
    "electron": "39.8.10",
    "playwright": "^1.56.0",
    "prettier": "3.6.2",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  },
  "productName": "Mojive",
  "engines": {
    "node": ">=22"
  }
}
