<mujoco model="Driven pendulum">
  <option timestep="0.002" integrator="implicitfast"/>
  <worldbody>
    <light pos="0 -3 4" dir="0 0 -1"/>
    <geom name="floor" type="plane" size="3 3 0.1" rgba="0.32 0.36 0.4 1"/>
    <geom name="stand" type="capsule" fromto="0 0 0 0 0 1.5" size="0.06" rgba="0.4 0.45 0.5 1"/>
    <body name="pendulum" pos="0 -0.15 1.5">
      <joint name="hinge" axis="0 1 0" damping="0.05" range="-170 170"/>
      <geom name="rod" type="capsule" fromto="0 0 0 0.5 0 -0.8" size="0.045" rgba="0.65 0.78 0.55 1"/>
      <geom name="bob" type="sphere" pos="0.5 0 -0.8" size="0.12" mass="1" rgba="0.9 0.62 0.3 1"/>
    </body>
    <camera name="overview" pos="3 -4 2.5" xyaxes="0.8 0.6 0 -0.18 0.24 0.954"/>
  </worldbody>
  <actuator><motor name="pendulum_motor" joint="hinge" ctrlrange="-5 5"/></actuator>
</mujoco>
